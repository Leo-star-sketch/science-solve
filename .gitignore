:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #1c2333;
  background: #f4f7fb;
  line-height: 1.5;
  font-weight: 400;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: linear-gradient(180deg, #edf4ff 0%, #f9fbff 100%);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.page-shell {
  max-width: 1220px;
  margin: 0 auto;
  padding: 20px 24px 60px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(21, 109, 255, 0.08);
  border-radius: 18px;
  padding: 14px 18px;
  position: sticky;
  top: 12px;
  z-index: 10;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #2a7de1, #7fd6ff);
  color: white;
  font-weight: 700;
}

.brand-name {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
}

.brand-subtitle {
  display: block;
  font-size: 0.72rem;
  color: #5f6f89;
}

.nav {
  display: flex;
  gap: 20px;
  color: #33415c;
  font-weight: 600;
}

.hero {
  display: grid;
  grid-template-columns: 1.4fr 0.7fr;
  gap: 24px;
  padding: 52px 0 26px;
  align-items: center;
}

.hero-copy h1 {
  margin: 12px 0 16px;
  font-size: clamp(2.3rem, 4vw, 4.3rem);
  line-height: 1.08;
  color: #0f172a;
}

.hero-copy p {
  margin: 0;
  font-size: 1.08rem;
  color: #475569;
  max-width: 560px;
}

.badge {
  display: inline-block;
  background: #dfeeff;
  color: #1c5fd6;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 700;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-top: 26px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.options button {
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, #2b6ef5, #3aa2ff);
  color: white;
  box-shadow: 0 12px 24px rgba(42, 123, 255, 0.24);
}

.secondary-btn {
  background: white;
  color: #1e293b;
  border: 1px solid rgba(15, 23, 42, 0.08);
}

.primary-btn:hover,
.secondary-btn:hover,
.options button:hover {
  transform: translateY(-1px);
}

.hero-panel {
  background: linear-gradient(180deg, #ffffff, #edf6ff);
  border-radius: 24px;
  padding: 26px;
  border: 1px solid rgba(30, 64, 175, 0.08);
  box-shadow: 0 20px 45px rgba(15, 23, 42, 0.06);
  display: grid;
  gap: 16px;
}

.mini-stat {
  background: white;
  border-radius: 16px;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  border: 1px solid rgba(15, 23, 42, 0.04);
}

.mini-stat strong {
  font-size: 1.7rem;
  color: #0f172a;
}

.mini-stat span {
  color: #475569;
}

.panel {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  padding: 24px;
  box-shadow: 0 18px 32px rgba(18, 29, 52, 0.04);
  margin-top: 26px;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.eyebrow {
  margin: 0 0 6px;
  color: #3b82f6;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 0.66rem;
}

.section-title-row h2 {
  margin: 0;
  font-size: clamp(1.6rem, 2vw, 2.1rem);
  color: #111827;
}

select {
  border: 1px solid rgba(148, 163, 184, 0.4);
  background: #f8fafc;
  color: #111827;
  padding: 10px 14px;
  border-radius: 12px;
}

.solver-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.input-card,
.result-card,
.quiz-box,
.module-card,
.progress-card {
  background: #f9fbff;
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  padding: 18px;
}

.input-card label {
  display: block;
  margin-bottom: 10px;
  font-weight: 700;
  color: #334155;
}

textarea {
  width: 100%;
  border: 1px solid rgba(148, 163, 184, 0.4);
  border-radius: 14px;
  background: white;
  padding: 14px;
  resize: vertical;
  min-height: 150px;
  color: #0f172a;
}

.full {
  width: 100%;
  margin-top: 14px;
}

.result-card h3 {
  margin: 16px 0 12px;
  font-size: 1.2rem;
}

.result-card ul,
.quick-tips ul,
.progress-card ul,
.history ul {
  margin: 0;
  padding-left: 18px;
  color: #475569;
}

.tag {
  display: inline-block;
  background: #e0f2fe;
  color: #0369a1;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.72rem;
  font-weight: 700;
}

.answer-box {
  margin-top: 16px;
  background: #ecfdf5;
  border-left: 4px solid #10b981;
  padding: 12px 14px;
  border-radius: 10px;
}

.answer-box p {
  margin: 8px 0 0;
  color: #0f172a;
}

.quiz-box {
  max-width: 760px;
}

.question {
  font-size: 1.1rem;
  font-weight: 700;
  color: #0f172a;
  margin-top: 0;
}

.options {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 18px;
}

.options button {
  background: white;
  color: #0f172a;
  border: 1px solid rgba(15, 23, 42, 0.08);
}

.feedback {
  margin-top: 16px;
  background: #eff6ff;
  color: #1d4ed8;
  border-radius: 12px;
  padding: 10px 12px;
  font-weight: 600;
}

.score-pill {
  background: #e2e8f0;
  color: #0f172a;
  padding: 8px 12px;
  border-radius: 999px;
  font-weight: 700;
}

.cards-grid,
.progress-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.module-card {
  min-height: 180px;
}

.module-icon {
  font-size: 1.8rem;
}

.module-card h3 {
  margin: 12px 0 8px;
  font-size: 1.12rem;
}

.module-card p {
  margin: 0 0 12px;
  color: #475569;
}

.module-card small {
  color: #2563eb;
  font-weight: 700;
}

.progress-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.progress-card h4 {
  margin-top: 0;
  margin-bottom: 10px;
}

.metrics {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 160px;
}

.metrics strong {
  font-size: 2.1rem;
  color: #111827;
}

.metrics span {
  margin-top: 8px;
  color: #475569;
}

@media (max-width: 900px) {
  .hero,
  .solver-grid,
  .cards-grid,
  .progress-grid {
    grid-template-columns: 1fr;
  }

  .nav {
    display: none;
  }
}
